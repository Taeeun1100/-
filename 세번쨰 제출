// ==============================
// Particle effects
// ==============================

static float randUnit(void) {
    return (float)GetRandomValue(0, 10000) / 10000.0f;
}

static void burstRow(int row, int strength) {
    for (int x = 0; x < BW; x++) {
        Color c = colors[board[row][x] ? board[row][x] : 1];

        for (int j = 0; j < strength; j++) {
            Particle* p =
                &particles[particleCursor++ % MAX_PARTICLES];

            p->x = OX + x * CELL + CELL * randUnit();
            p->y = OY + row * CELL + CELL * randUnit();

            p->vx = (randUnit() - 0.5f) * 430.0f;
            p->vy = -80.0f - randUnit() * 320.0f;

            p->life = p->maxLife =
                0.4f + randUnit() * 0.55f;

            p->color = c;
        }
    }
}

static void updateEffects(float dt) {
    for (int i = 0; i < MAX_PARTICLES; i++) {
        if (particles[i].life > 0) {
            Particle* p = &particles[i];

            p->life -= dt;
            p->x += p->vx * dt;
            p->y += p->vy * dt;

            p->vy += 550 * dt;
            p->vx *= 1.0f - 0.8f * dt;
        }
    }

    if (flashTimer > 0) flashTimer -= dt;
    if (shakeTimer > 0) shakeTimer -= dt;
    if (awardTimer > 0) awardTimer -= dt;
}

// ==============================
// Board and pieces
// ==============================

static int occupied(int t, int r, int x, int y) {
    return shapes[t][r][y * 4 + x] == 'X';
}

static int fits(Piece p) {
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            if (occupied(p.type, p.rot, x, y)) {
                int bx = p.x + x;
                int by = p.y + y;

                if (bx < 0 || bx >= BW || by >= BH)
                    return 0;

                if (by >= 0 && board[by][bx])
                    return 0;
            }
        }
    }
    return 1;
}

static void refillBag(void) {
    for (int i = 0; i < 7; i++)
        bag[i] = i;

    for (int i = 6; i > 0; i--) {
        int j = GetRandomValue(0, i);
        int t = bag[i];

        bag[i] = bag[j];
        bag[j] = t;
    }

    bagIndex = 0;
}

static int nextFromBag(void) {
    if (bagIndex >= 7)
        refillBag();

    return bag[bagIndex++];
}

static void announce(const char* s) {
    snprintf(eventText, sizeof(eventText), "%s", s);
    eventTimer = 1.7f;
}

static void spawn(int type) {
    cur = (Piece){ type, 0, 3, -1 };

    fallTimer = 0;
    lockTimer = 0;
    lockResets = 0;
    lastRotate = 0;
    lastKick = 0;

    if (!fits(cur))
        gameOver = 1;
}

static void takeNext(void) {
    int t = queue[0];

    for (int i = 0; i < 4; i++)
        queue[i] = queue[i + 1];

    queue[4] = nextFromBag();

    spawn(t);
    holdUsed = 0;
}

static void resetGame(void) {
    memset(board, 0, sizeof(board));

    bagIndex = 7;
    refillBag();

    for (int i = 0; i < 5; i++)
        queue[i] = nextFromBag();

    held = -1;
    holdUsed = 0;

    score = 0;
    lines = 0;
    gameOver = 0;
    paused = 0;

    level = 1;
    combo = -1;

    moveTimer = 0;
    downTimer = 0;
    eventTimer = 0;
    eventText[0] = 0;

    memset(particles, 0, sizeof(particles));
    memset(flashRows, 0, sizeof(flashRows));

    particleCursor = 0;
    flashTimer = 0;
    shakeTimer = 0;
    awardTimer = 0;
    lastAward = 0;

    takeNext();
}

static int grounded(void) {
    Piece p = cur;
    p.y++;
    return !fits(p);
}

static void resetLockOnAction(int wasGrounded) {
    if (wasGrounded && lockResets < MAX_RESETS) {
        lockTimer = 0;
        lockResets++;
    }
}

static int movePiece(int dx, int dy, int manual) {
    Piece p = cur;

    p.x += dx;
    p.y += dy;

    if (!fits(p))
        return 0;

    int wasGrounded = grounded();
    cur = p;

    if (manual) {
        lastRotate = 0;
        resetLockOnAction(wasGrounded);
    }

    return 1;
}

