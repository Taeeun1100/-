static const int jlKick[4][2][5][2] = {
    {
        {{0,0},{-1,0},{-1,-1},{0,2},{-1,2}},
        {{0,0},{1,0},{1,-1},{0,2},{1,2}}
    },
    {
        {{0,0},{1,0},{1,1},{0,-2},{1,-2}},
        {{0,0},{1,0},{1,1},{0,-2},{1,-2}}
    },
    {
        {{0,0},{1,0},{1,-1},{0,2},{1,2}},
        {{0,0},{-1,0},{-1,-1},{0,2},{-1,2}}
    },
    {
        {{0,0},{-1,0},{-1,1},{0,-2},{-1,-2}},
        {{0,0},{-1,0},{-1,1},{0,-2},{-1,-2}}
    }
};

static const int iKick[4][2][5][2] = {
    {
        {{0,0},{-2,0},{1,0},{-2,1},{1,-2}},
        {{0,0},{-1,0},{2,0},{-1,-2},{2,1}}
    },
    {
        {{0,0},{-1,0},{2,0},{-1,-2},{2,1}},
        {{0,0},{2,0},{-1,0},{2,-1},{-1,2}}
    },
    {
        {{0,0},{2,0},{-1,0},{2,-1},{-1,2}},
        {{0,0},{1,0},{-2,0},{1,2},{-2,-1}}
    },
    {
        {{0,0},{1,0},{-2,0},{1,2},{-2,-1}},
        {{0,0},{-2,0},{1,0},{-2,1},{1,-2}}
    }
};

static void rotatePiece(int dir) {
    int nr = (cur.rot + dir + 4) % 4;
    int idx = (dir == 1) ? 0 : 1;
    int wasGrounded = grounded();

    for (int k = 0; k < 5; k++) {
        Piece p = cur;
        p.rot = nr;

        if (cur.type != 1) {
            const int (*kick)[2] =
                (cur.type == 0)
                ? iKick[cur.rot][idx]
                : jlKick[cur.rot][idx];

            p.x += kick[k][0];
            p.y += kick[k][1];
        }
        else if (k > 0) {
            break;
        }

        if (fits(p)) {
            cur = p;
            lastRotate = 1;
            lastKick = k;

            resetLockOnAction(wasGrounded);
            return;
        }
    }
}

// ==============================
// T-spin detection
// ==============================

static int solidCorner(int x, int y) {
    if (x < 0 || x >= BW || y >= BH)
        return 1;

    if (y < 0)
        return 0;

    return board[y][x] != 0;
}

static int tspinType(void) {
    if (cur.type != 2 || !lastRotate)
        return 0;

    int cx = cur.x + 1;
    int cy = cur.y + 1;

    int corners =
        solidCorner(cx - 1, cy - 1) +
        solidCorner(cx + 1, cy - 1) +
        solidCorner(cx - 1, cy + 1) +
        solidCorner(cx + 1, cy + 1);

    if (corners < 3)
        return 0;

    int front = 0;

    switch (cur.rot) {
    case 0:
        front = solidCorner(cx - 1, cy - 1)
            + solidCorner(cx + 1, cy - 1);
        break;

    case 1:
        front = solidCorner(cx + 1, cy - 1)
            + solidCorner(cx + 1, cy + 1);
        break;

    case 2:
        front = solidCorner(cx - 1, cy + 1)
            + solidCorner(cx + 1, cy + 1);
        break;

    default:
        front = solidCorner(cx - 1, cy - 1)
            + solidCorner(cx - 1, cy + 1);
        break;
    }

    return (front == 2 || lastKick == 4) ? 2 : 1;
}

// ==============================
// Lock and line clear
// ==============================

static void lockPiece(void) {
    int spin = tspinType();

    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            if (occupied(cur.type, cur.rot, x, y)) {
                int by = cur.y + y;
                int bx = cur.x + x;

                if (by < 0) {
                    gameOver = 1;
                    return;
                }

                board[by][bx] = cur.type + 1;
            }
        }
    }

    int cleared = 0;
    memset(flashRows, 0, sizeof(flashRows));

    for (int y = BH - 1; y >= 0;) {
        int full = 1;

        for (int x = 0; x < BW; x++) {
            if (!board[y][x]) {
                full = 0;
                break;
            }
        }

        if (full) {
            flashRows[y] = 1;

            burstRow(y, spin ? 7 : 5);
            cleared++;

            for (int j = y; j > 0; j--) {
                memcpy(
                    board[j],
                    board[j - 1],
                    sizeof(board[j])
                );
            }

            memset(board[0], 0, sizeof(board[0]));
        }
        else {
            y--;
        }
    }

    static const int normalPts[5] =
    { 0, 100, 300, 500, 800 };

    static const int fullPts[4] =
    { 400, 800, 1200, 1600 };

    static const int miniPts[3] =
    { 100, 200, 400 };

    int base = normalPts[cleared];

    if (spin == 2)
        base = fullPts[cleared > 3 ? 3 : cleared];

    if (spin == 1)
        base = miniPts[cleared > 2 ? 2 : cleared];

    int previousScore = score;
    score += base * level;

    if (cleared) {
        combo++;
        score += combo * 50 * level;

        lines += cleared;
        level = 1 + lines / 10;

        if (spin)
            announce(spin == 2 ? "T-SPIN!" : "T-SPIN MINI!");
        else if (cleared == 4)
            announce("TETRIS!");
        else if (cleared == 3)
            announce("TRIPLE!");
        else if (cleared == 2)
            announce("DOUBLE!");
        else
            announce("SINGLE!");
    }
    else {
        combo = -1;

        if (spin)
            announce(spin == 2 ? "T-SPIN!" : "T-SPIN MINI!");
    }

    if (cleared) {
        flashTimer = 0.24f;

        shakeTimer = cleared >= 2 ? 0.23f : 0.10f;

        if (spin || cleared == 4)
            shakeTimer = 0.40f;
    }

    lastAward = score - previousScore;
    awardTimer = lastAward > 0 ? 1.1f : 0;

    takeNext();
}

static void hardDrop(void) {
    int distance = 0;

    while (movePiece(0, 1, 0))
        distance++;

    score += distance * 2;
    lockPiece();
}

static void holdPiece(void) {
    if (holdUsed)
        return;

    int old = cur.type;

    if (held < 0) {
        held = old;
        takeNext();
    }
    else {
        int t = held;
        held = old;
        spawn(t);
    }

    holdUsed = 1;
}

