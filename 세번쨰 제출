static void drawCell(int x, int y, int t, int alpha) {
    Color c = colors[t];
    c.a = (unsigned char)alpha;

    Rectangle rect = {
        (float)x + 1,
        (float)y + 1,
        CELL - 2,
        CELL - 2
    };

    DrawRectangleRounded(rect, 0.15f, 3, c);

    if (alpha == 255) {
        DrawRectangle(
            x + 5, y + 4, CELL - 10, 3,
            Fade(WHITE, 0.25f)
        );

        DrawRectangleLinesEx(
            (Rectangle) {
            (float)x + 1,
                (float)y + 1,
                CELL - 2,
                CELL - 2
        },
            1,
            Fade(BLACK, 0.25f)
        );
    }
}

// Center a preview piece inside its panel.
static void drawMini(
    int type,
    int px,
    int py,
    int width,
    int height,
    int cell
) {
    if (type < 0)
        return;

    int minX = 4, minY = 4;
    int maxX = -1, maxY = -1;

    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            if (occupied(type, 0, x, y)) {
                if (x < minX) minX = x;
                if (x > maxX) maxX = x;
                if (y < minY) minY = y;
                if (y > maxY) maxY = y;
            }
        }
    }

    int sx = px +
        (width - (maxX - minX + 1) * cell) / 2;

    int sy = py +
        (height - (maxY - minY + 1) * cell) / 2;

    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            if (occupied(type, 0, x, y)) {
                int bx = sx + (x - minX) * cell;
                int by = sy + (y - minY) * cell;

                DrawRectangleRounded(
                    (Rectangle) {
                    (float)bx,
                        (float)by,
                        (float)cell - 2,
                        (float)cell - 2
                },
                    0.15f,
                    2,
                    colors[type + 1]
                );
            }
        }
    }
}

static void drawGame(void) {
    ClearBackground((Color) { 12, 16, 28, 255 });

    DrawText(
        "TETRIS  /  RAYLIB",
        OX, 18, 25, RAYWHITE
    );

    int shakeX = 0;
    int shakeY = 0;

    if (shakeTimer > 0) {
        shakeX = GetRandomValue(-5, 5);
        shakeY = GetRandomValue(-4, 4);
    }

    BeginScissorMode(
        OX - 8, OY - 8,
        BW * CELL + 16,
        BH * CELL + 16
    );

    Camera2D camera = { 0 };
    camera.offset = (Vector2){
        (float)shakeX,
        (float)shakeY
    };
    camera.zoom = 1.0f;

    BeginMode2D(camera);

    DrawRectangle(
        OX - 3, OY - 3,
        BW * CELL + 6,
        BH * CELL + 6,
        (Color) {
        75, 90, 125, 255
    }
    );

    DrawRectangle(
        OX, OY,
        BW * CELL,
        BH * CELL,
        colors[0]
    );

    // Board
    for (int y = 0; y < BH; y++) {
        for (int x = 0; x < BW; x++) {
            DrawRectangleLines(
                OX + x * CELL,
                OY + y * CELL,
                CELL,
                CELL,
                (Color) {
                35, 42, 60, 255
            }
            );

            if (board[y][x]) {
                drawCell(
                    OX + x * CELL,
                    OY + y * CELL,
                    board[y][x],
                    255
                );
            }
        }
    }

    if (!gameOver) {
        Piece ghost = cur;

        while (1) {
            Piece p = ghost;
            p.y++;

            if (!fits(p))
                break;

            ghost = p;
        }

        // Ghost piece
        for (int y = 0; y < 4; y++) {
            for (int x = 0; x < 4; x++) {
                if (occupied(cur.type, cur.rot, x, y)) {
                    int gx = ghost.x + x;
                    int gy = ghost.y + y;

                    if (gy >= 0) {
                        DrawRectangleLinesEx(
                            (Rectangle) {
                            (float)(OX + gx * CELL + 3),
                                (float)(OY + gy * CELL + 3),
                                CELL - 6,
                                CELL - 6
                        },
                            2,
                            Fade(colors[cur.type + 1], 0.65f)
                        );
                    }
                }
            }
        }

        // Current piece
        for (int y = 0; y < 4; y++) {
            for (int x = 0; x < 4; x++) {
                if (occupied(cur.type, cur.rot, x, y)) {
                    int bx = cur.x + x;
                    int by = cur.y + y;

                    if (by >= 0) {
                        drawCell(
                            OX + bx * CELL,
                            OY + by * CELL,
                            cur.type + 1,
                            255
                        );
                    }
                }
            }
        }
    }

    // Line-clear flash
    if (flashTimer > 0) {
        float alpha = flashTimer / 0.24f;

        for (int y = 0; y < BH; y++) {
            if (flashRows[y]) {
                DrawRectangle(
                    OX,
                    OY + y * CELL,
                    BW * CELL,
                    CELL,
                    Fade(WHITE, alpha * 0.85f)
                );
            }
        }
    }

    // Particles
    for (int i = 0; i < MAX_PARTICLES; i++) {
        if (particles[i].life > 0) {
            Particle* p = &particles[i];

            DrawRectangle(
                (int)p->x,
                (int)p->y,
                5, 5,
                Fade(
                    p->color,
                    p->life / p->maxLife
                )
            );
        }
    }

    EndMode2D();
    EndScissorMode();

    // Hold panel
    DrawText("HOLD", 55, 80, 23, RAYWHITE);

    DrawRectangle(
        38, 112, 160, 130,
        (Color) {
        29, 36, 54, 255
    }
    );

    drawMini(held, 38, 112, 160, 130, 27);

    // Score panel
    DrawText("SCORE", 40, 265, 22, RAYWHITE);
    DrawText(
        TextFormat("%d", score),
        40, 299, 26,
        (Color) {
        250, 215, 95, 255
    }
    );

    DrawText("LINES", 40, 365, 22, RAYWHITE);
    DrawText(
        TextFormat("%d", lines),
        40, 398, 25, RAYWHITE
    );

    DrawText("LEVEL", 40, 465, 22, RAYWHITE);
    DrawText(
        TextFormat("%d", level),
        40, 498, 25, RAYWHITE
    );

    // Next queue
    DrawText("NEXT", 550, 80, 23, RAYWHITE);

    for (int i = 0; i < 5; i++) {
        int py = 116 + i * 103;

        DrawRectangle(
            540, py, 160, 94,
            (Color) {
            29, 36, 54, 255
        }
        );

        drawMini(
            queue[i],
            540, py,
            160, 94, 20
        );
    }

    // Controls
    DrawText(
        "ARROWS : MOVE",
        35, 690, 17, LIGHTGRAY
    );

    DrawText(
        "Z/X : ROTATE    C : HOLD    SPACE : DROP",
        225, 690, 16, LIGHTGRAY
    );

    DrawText(
        "P : PAUSE     R : RESTART",
        225, 714, 16, LIGHTGRAY
    );

    // Event message
    if (eventTimer > 0) {
        DrawText(
            eventText,
            OX + 12,
            OY + BH * CELL - 40,
            24,
            (Color) {
            255, 220, 105, 255
        }
        );
    }

    // Score popup
    if (awardTimer > 0 && lastAward > 0) {
        DrawText(
            TextFormat("+%d", lastAward),
            OX + 75,
            OY + 180 - (int)((1.1f - awardTimer) * 32),
            32,
            Fade(GOLD, awardTimer / 1.1f)
        );
    }

    if (paused || gameOver) {
        DrawRectangle(
            OX, OY,
            BW * CELL,
            BH * CELL,
            Fade(BLACK, 0.72f)
        );

        const char* msg =
            gameOver ? "GAME OVER" : "PAUSED";

        DrawText(
            msg,
            OX + (BW * CELL - MeasureText(msg, 33)) / 2,
            OY + 250,
            33,
            RAYWHITE
        );

        DrawText(
            "PRESS R TO RESTART",
            OX + 32,
            OY + 300,
            19,
            LIGHTGRAY
        );
    }
}

// ==============================
// Main
// ==============================

int main(void) {
    InitWindow(
        740, 760,
        "Tetris - C / raylib"
    );

    SetTargetFPS(60);
    SetRandomSeed((unsigned int)time(NULL));

    resetGame();

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();

        if (dt > 0.05f)
            dt = 0.05f;

        if (!paused)
            updateEffects(dt);

        if (IsKeyPressed(KEY_R))
            resetGame();

        if (IsKeyPressed(KEY_P) && !gameOver)
            paused = !paused;

        if (!paused && !gameOver) {
            if (eventTimer > 0)
                eventTimer -= dt;

            if (IsKeyPressed(KEY_C))
                holdPiece();

            if (IsKeyPressed(KEY_Z))
                rotatePiece(-1);

            if (IsKeyPressed(KEY_X) ||
                IsKeyPressed(KEY_UP))
                rotatePiece(1);

            int direction =
                (IsKeyDown(KEY_LEFT) ? -1 : 0) +
                (IsKeyDown(KEY_RIGHT) ? 1 : 0);

            if (IsKeyPressed(KEY_LEFT)) {
                movePiece(-1, 0, 1);
                moveTimer = 0;
            }
            else if (IsKeyPressed(KEY_RIGHT)) {
                movePiece(1, 0, 1);
                moveTimer = 0;
            }
            else if (direction) {
                moveTimer += dt;

                if (moveTimer > 0.17f) {
                    while (moveTimer > 0.17f) {
                        movePiece(direction, 0, 1);
                        moveTimer -= 0.045f;
                    }
                }
            }
            else {
                moveTimer = 0;
            }

            if (IsKeyPressed(KEY_SPACE)) {
                hardDrop();
            }
            else {
                float interval =
                    0.8f - 0.055f * (level - 1);

                if (interval < 0.07f)
                    interval = 0.07f;

                if (IsKeyDown(KEY_DOWN))
                    interval = 0.035f;

                fallTimer += dt;

                while (fallTimer >= interval) {
                    fallTimer -= interval;

                    if (movePiece(0, 1, 0) &&
                        IsKeyDown(KEY_DOWN)) {
                        score++;
                    }
                    else if (grounded()) {
                        break;
                    }
                }

                if (grounded()) {
                    lockTimer += dt;

                    if (lockTimer >= LOCK_TIME)
                        lockPiece();
                }
                else {
                    lockTimer = 0;
                }
            }
        }

        BeginDrawing();
        drawGame();
        EndDrawing();
    }

    CloseWindow();
    return 0;
}

