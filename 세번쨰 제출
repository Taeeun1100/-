#include "raylib.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <math.h>

#define BW 10
#define BH 20
#define CELL 30
#define OX 225
#define OY 65
#define LOCK_TIME 0.5f
#define MAX_RESETS 15
#define MAX_PARTICLES 260

typedef struct {
    int type, rot, x, y;
} Piece;

typedef struct {
    float x, y, vx, vy;
    float life, maxLife;
    Color color;
} Particle;

static int board[BH][BW];
static Piece cur;

static int bag[7], bagIndex;
static int queue[5], held, holdUsed;
static int score, lines, level, gameOver, paused, combo;

static float fallTimer, lockTimer, moveTimer, downTimer;
static int lockResets, lastRotate, lastKick;

static char eventText[80];
static float eventTimer;

static Particle particles[MAX_PARTICLES];
static int particleCursor;
static float flashTimer, shakeTimer;
static int flashRows[BH];
static int lastAward;
static float awardTimer;

// I O T S Z J L
static const char* shapes[7][4] = {
